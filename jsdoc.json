{
    "plugins": [],
    "recurseDepth": 10,
    "source": {
        "includePattern": ".+\\.js(doc|x)?$",
        "excludePattern": "(^|\\/|\\\\)_",
        "include": [ "src/" ],
        "exclude": [ "node_modules/" ]
    },
    "sourceType": "module",
    "tags": {
        "allowUnknownTags": true,
        "dictionaries": ["jsdoc","closure"]
    },
    "templates": {
        "cleverLinks": false,
        "monospaceLinks": false,
        "search": true,
        "better-docs": {
            "name": "Chemistry for All",
            "navLinks": [
                {
                    "label": "GitHub",
                    "href": "https://github.com/Chemistry-for-All-Group/chemistry-for-all"
                },
                {
                    "label": "Website",
                    "href": "https://chemistry-for-all-group.github.io/chemistry-for-all/"
                }
            ]
        }
    },
    "opts": {
        "destination": "docs/",
        "template": "node_modules/better-docs",
        "recurse": true,
        "readme": "README.md"
    }
}
{
    "plugins": [],
    "recurseDepth": 10,
    "source": {
        "includePattern": ".+\\.js(doc|x)?$",
        "excludePattern": "(^|\\/|\\\\)_",
        "include": [ "src/" ],
        "exclude": [ "node_modules/" ]
    },
    "sourceType": "module",
    "tags": {
        "allowUnknownTags": true,
        "dictionaries": ["jsdoc","closure"]
    },
    "templates": {
        "cleverLinks": false,
        "monospaceLinks": false,
        "search": true
    },
    "opts": {
        "destination": "docs/",
        "template": "node_modules/better-docs",
        "recurse": true,
        "readme": "README.md"
    }
}